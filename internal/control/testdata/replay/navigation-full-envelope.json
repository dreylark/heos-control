{
  "version": 1,
  "name": "navigation-full-envelope",
  "family": "navigation",
  "provenance": "synthetic",
  "source": "docs/DEVICE_COMPATIBILITY.md",
  "model": "Home 150",
  "firmware": null,
  "notes": [
    "Synthetic 1200-second envelope using navigation-stop-qid identities: transition at 268 seconds, settle at 270. Playback must still fade and Stop at the original deadline. Controller clock only; this does not simulate Observer.Run timer scheduling."
  ],
  "initial": {
    "state": "pause",
    "volume": 20,
    "muted": false,
    "repeat": "off",
    "shuffle": false
  },
  "automation": {
    "target_level": 12,
    "ramp_seconds": 1,
    "duration_seconds": 1200,
    "fade_seconds": 1
  },
  "scripts": [
    {
      "on": "browse/add_to_queue",
      "occurrence": 1,
      "args": {
        "pid": "1",
        "sid": "900",
        "cid": "green",
        "aid": "4"
      },
      "steps": [
        {
          "at_ms": 0,
          "action": "apply",
          "patch": {
            "state": "play",
            "queue": "selected",
            "media": {
              "mid": "track-1",
              "qid": "1",
              "source": "1024"
            }
          }
        },
        {
          "at_ms": 0,
          "action": "reply",
          "result": "success"
        },
        {
          "at_ms": 268000,
          "action": "apply",
          "patch": {
            "state": "stop",
            "media": {
              "mid": "track-1",
              "qid": "2",
              "source": "1024"
            }
          }
        },
        {
          "at_ms": 268000,
          "action": "event",
          "event": {
            "command": "event/player_now_playing_changed",
            "params": {
              "pid": "1"
            }
          }
        },
        {
          "at_ms": 268000,
          "action": "event",
          "event": {
            "command": "event/player_state_changed",
            "params": {
              "pid": "1",
              "state": "stop"
            }
          }
        },
        {
          "at_ms": 270000,
          "action": "apply",
          "patch": {
            "state": "play",
            "media": {
              "mid": "track-2",
              "qid": "2",
              "source": "1024"
            }
          }
        },
        {
          "at_ms": 270000,
          "action": "event",
          "event": {
            "command": "event/player_state_changed",
            "params": {
              "pid": "1",
              "state": "play"
            }
          }
        },
        {
          "at_ms": 270000,
          "action": "event",
          "event": {
            "command": "event/player_now_playing_changed",
            "params": {
              "pid": "1"
            }
          }
        }
      ]
    }
  ],
  "expect": {
    "state": "succeeded",
    "reason": "completed",
    "volume_levels": [
      10,
      11,
      12,
      9,
      6,
      3,
      0
    ],
    "max_full_reads": 12,
    "max_scalar_reads": 0,
    "max_wire_gets": 65,
    "max_wire_writes": 11,
    "end_ms": 1200000,
    "no_writes": [
      {
        "from_ms": 268000,
        "until_ms": 270000
      }
    ],
    "queue_writes": 1,
    "volume_at_ms": [
      0,
      500,
      1000,
      1199250,
      1199500,
      1199750,
      1200000
    ],
    "stop_at_ms": 1200000
  }
}

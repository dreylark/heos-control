{
  "version": 1,
  "name": "intervention-volume",
  "family": "intervention",
  "provenance": "synthetic",
  "source": "docs/DEVICE_COMPATIBILITY.md",
  "model": "Home 150",
  "firmware": null,
  "notes": [
    "Synthetic volume intervention at 1500 ms after complete queue confirmation.",
    "Checks ownership release and removal of future ramp/fade/Stop writes; this is not a recorded device trace."
  ],
  "initial": {
    "state": "pause",
    "volume": 20,
    "muted": false,
    "repeat": "off",
    "shuffle": false
  },
  "automation": {
    "target_level": 12,
    "ramp_seconds": 1,
    "duration_seconds": 3,
    "fade_seconds": 1
  },
  "scripts": [
    {
      "on": "browse/add_to_queue",
      "occurrence": 1,
      "args": {
        "pid": "1",
        "sid": "900",
        "cid": "green",
        "aid": "4"
      },
      "steps": [
        {
          "at_ms": 0,
          "action": "apply",
          "patch": {
            "state": "play",
            "queue": "selected",
            "media": {
              "mid": "track-1",
              "qid": "1",
              "source": "1024"
            }
          }
        },
        {
          "at_ms": 0,
          "action": "reply",
          "result": "success"
        },
        {
          "at_ms": 1500,
          "action": "apply",
          "patch": {
            "volume": 17
          }
        },
        {
          "at_ms": 1500,
          "action": "event",
          "event": {
            "command": "event/player_volume_changed",
            "params": {
              "pid": "1",
              "level": "17",
              "mute": "off"
            }
          }
        }
      ]
    }
  ],
  "expect": {
    "state": "released",
    "reason": "unexpected_event",
    "volume_levels": [
      10,
      11,
      12
    ],
    "max_full_reads": 3,
    "max_scalar_reads": 0,
    "max_wire_gets": 65,
    "max_wire_writes": 6,
    "end_ms": 1500,
    "no_writes": [
      {
        "from_ms": 1500,
        "until_ms": 100000
      }
    ],
    "queue_writes": 1
  }
}

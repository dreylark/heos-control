{
  "version": 1,
  "name": "delayed-mode",
  "family": "mode",
  "provenance": "reconstructed",
  "source": "docs/DEVICE_COMPATIBILITY.md",
  "model": "Home 150",
  "firmware": null,
  "notes": [
    "Reconstructs the 2026-09-10 Home 150 delayed play-mode finding in the reference: reply succeeds before shuffle becomes on.",
    "The 350 ms interval, initial queue, immediate baseline replies and successful playback continuation are synthetic; they are not a raw trace."
  ],
  "initial": {
    "state": "pause",
    "volume": 20,
    "muted": false,
    "repeat": "off",
    "shuffle": false
  },
  "automation": {
    "target_level": 12,
    "ramp_seconds": 1,
    "duration_seconds": 3,
    "fade_seconds": 1
  },
  "scripts": [
    {
      "on": "player/set_play_mode",
      "occurrence": 1,
      "args": {
        "repeat": "off",
        "shuffle": "on",
        "pid": "1"
      },
      "steps": [
        {
          "at_ms": 0,
          "action": "reply",
          "result": "success"
        },
        {
          "at_ms": 350,
          "action": "apply",
          "patch": {
            "shuffle": true
          }
        },
        {
          "at_ms": 350,
          "action": "event",
          "event": {
            "command": "event/shuffle_mode_changed",
            "params": {
              "pid": "1",
              "shuffle": "on"
            }
          }
        }
      ]
    }
  ],
  "expect": {
    "state": "succeeded",
    "reason": "completed",
    "volume_levels": [
      10,
      11,
      12,
      9,
      6,
      3,
      0
    ],
    "max_full_reads": 5,
    "max_scalar_reads": 0,
    "max_wire_gets": 60,
    "max_wire_writes": 11,
    "end_ms": 3350,
    "no_writes": [

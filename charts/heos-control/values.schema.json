{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "api",
    "database",
    "shutdownSeconds",
    "terminationGracePeriodSeconds",
    "resources",
    "networkPolicy",
    "imagePullSecrets",
    "players",
    "sources",
    "migration"
  ],
  "properties": {
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {"enum": ["debug", "info", "warn", "error"]}
      }
    },
    "global": {
      "type": "object",
      "description": "Parent Helm chart globals, injected into dependencies by Helm. Not used by this chart."
    },
    "replicaCount": {
      "type": "integer",
      "const": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "tlsSecret",
        "credentialsSecret",
        "docs"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "tlsSecret": {
          "type": "string",
          "minLength": 1
        },
        "credentialsSecret": {
          "type": "string"
        },
        "docs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Expose unauthenticated Scalar documentation and the embedded OpenAPI schema. API calls still require credentials."
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port",
        "name",
        "user",
        "credentialsSecret",
        "passwordKey",
        "caSecret",
        "caKey",
        "maxConnections",
        "timeoutSeconds",
        "lockTimeoutSeconds"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        },
        "credentialsSecret": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        },
        "caSecret": {
          "type": "string",
          "minLength": 1
        },
        "caKey": {
          "type": "string",
          "minLength": 1
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "lockTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "shutdownSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 2,
      "maximum": 60
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "apiPeers",
        "databasePeers",
        "heosPeers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiPeers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/peer"
          }
        },
        "databasePeers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/peer"
          }
        },
        "heosPeers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/peer"
          }
        }
      }
    },
    "players": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "address",
          "fingerprint_sha256",
          "serial",
          "model"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "address": {
            "type": "string",
            "pattern": ":1265$"
          },
          "fingerprint_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "serial": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "model": {
            "type": "string",
            "maxLength": 256
          },
          "volume_ceiling": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "writes_enabled": {
            "type": "boolean",
            "default": false
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "writes_enabled"
              ],
              "properties": {
                "writes_enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "volume_ceiling"
              ],
              "properties": {
                "volume_ceiling": {
                  "type": "integer"
                }
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "player",
          "name"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "player": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "udn": {
            "type": "string"
          }
        }
      }
    },
    "deploymentAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "credentialsSecret",
        "passwordKey",
        "serviceAccountName",
        "activeDeadlineSeconds",
        "hooks",
        "jobAnnotations",
        "resourceAnnotations",
        "resources"
      ],
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1
        },
        "credentialsSecret": {
          "type": "string",
          "minLength": 1
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1
        },
        "serviceAccountName": {
          "type": "string"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "hooks": {
          "enum": [
            "helm",
            "external"
          ]
        },
        "jobAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resourceAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "required": [
                "cpu",
                "memory"
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "namespaceSelector": {
          "type": "object"
        },
        "podSelector": {
          "type": "object"
        },
        "ipBlock": {
          "type": "object",
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "type": "string",
              "minLength": 1
            },
            "except": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "ipBlock"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "namespaceSelector"
                ]
              },
              {
                "required": [
                  "podSelector"
                ]
              }
            ]
          }
        },
        {
          "anyOf": [
            {
              "required": [
                "namespaceSelector"
              ]
            },
            {
              "required": [
                "podSelector"
              ]
            }
          ],
          "not": {
            "required": [
              "ipBlock"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "players": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "api": {
            "properties": {
              "credentialsSecret": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
